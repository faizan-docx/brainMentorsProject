rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users (admins) can read/write workshops and submissions
    // For demo purposes, we allow anyone to read active workshops
    match /workshops/{workshopId} {
      allow read: if true; // Public needs to read workshop details to fill form
      allow write: if request.auth != null; // Only admins can create/edit
    }

    match /submissions/{submissionId} {
      // Anyone can create a submission (ideally verified via Cloud Function, but this is simple setup)
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /otps/{otpId} {
      // Internal use only by Cloud Functions, no client access needed
      allow read, write: if false; 
    }
  }
}
