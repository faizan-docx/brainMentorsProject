rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /templates/{allPaths=**} {
      // Anyone can read templates (needed for preview), only admins can write
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /certificates/{allPaths=**} {
      // Anyone can read generated certificates (via public URL link sent to them)
      allow read: if true;
      allow write: if true; // Allowed temporarily for client-side uploads
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
